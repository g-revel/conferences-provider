{
  "name": "conferences-providers-backend",
  "version": "0.1.0",
  "description": "REST API serving conference/event provider data",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "eval": "promptfoo eval --config tests/evals/get-all-speakers.yaml && promptfoo eval --config tests/evals/get-speaks.yaml --max-concurrency 1",
    "refresh:speakers": "tsx scripts/refresh-speakers.ts",
    "refresh:events:light": "tsx scripts/refresh-events-light.ts",
    "refresh:events:heavy": "tsx scripts/refresh-events-heavy.ts",
    "refresh:videos": "tsx scripts/refresh-videos.ts",
    "refresh:priority-speakers": "tsx scripts/refresh-priority-speakers.ts"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "keywords": [],
  "author": "",
  "license": "MIT",
  "type": "module",
  "dependencies": {
    "@fastify/sensible": "^6.0.4",
    "@slack/web-api": "^7.16.0",
    "fastify": "^5.8.5",
    "fastify-plugin": "^5.1.0",
    "undici": "^8.11.2"
  },
  "devDependencies": {
    "@types/node": "^25.9.1",
    "promptfoo": "^0.121.14",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "vitest": "^4.1.9"
  }
}
