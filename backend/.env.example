# Server
PORT=3000
HOST=0.0.0.0

# Logging — options: fatal, error, warn, info, debug, trace, silent
LOG_LEVEL=info

# Slack — bot token avec scope users:read
SLACK_TOKEN=xoxb-tototo

# SearXNG — moteur de recherche auto-hébergé, utilisé par le run lourd (refresh:events:heavy).
# Pas de clé API. Démarrer avec : cd searxng && docker compose up -d
# SEARXNG_HOST=http://localhost:8080

# Ollama — serveur local, pas de clé API. Défauts si non définis :
# OLLAMA_HOST=http://localhost:11434
# OLLAMA_MODEL=llama3.1:8b
